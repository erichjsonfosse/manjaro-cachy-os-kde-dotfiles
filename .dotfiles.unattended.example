# ==============================================================================
# Manjaro & CachyOS KDE Dotfiles - Unattended Configuration Template
# ==============================================================================
# To use: Copy this file to '.dotfiles.unattended' in the root of the repository
# and set your configuration values below before running './init.sh'.
# ==============================================================================

# Required: Git user credentials
GIT_NAME="Your Name"
GIT_EMAIL_ADDRESS="your.email@example.com"

# Optional: GPG/SSH Signing key (leave empty if none)
GIT_SIGNING_KEY=""

# Required: System restart behavior upon completion:
#   - "ask"   : Prompt interactively with a confirmation dialog at the very end (Recommended)
#   - "true"  : Automatically reboot system with a 5-second countdown
#   - "false" : Cleanly exit without rebooting or prompting
AUTO_REBOOT="ask"
