#!/usr/bin/env bash
set -eo pipefail

# Capture the true user home before overriding
ORIGINAL_HOME="${REAL_HOME:-$HOME}"
if [[ -n "$REAL_HOME" ]]; then
    PROFILES_BASE="$REAL_HOME/.local/share/agy/profiles"
else
    PROFILES_BASE="${XDG_DATA_HOME:-$ORIGINAL_HOME/.local/share}/agy/profiles"
fi

# --- Git Repository Detection ---
detect_repo_name() {
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        return 1
    fi

    local repository_root
    repository_root="$(git rev-parse --show-toplevel 2>/dev/null)"

    # Priority 1: In-repo explicit override file (.agy-profile)
    if [[ -f "$repository_root/.agy-profile" ]]; then
        local override
        override="$(head -n 1 "$repository_root/.agy-profile" | tr -d '[:space:]')"
        if [[ -n "$override" ]]; then
            echo "$override"
            return 0
        fi
    fi

    # Priority 2: Remote URL (origin or first available remote)
    local remote_url
    remote_url="$(git config --get remote.origin.url 2>/dev/null)"
    if [[ -z "$remote_url" ]]; then
        local first_remote
        first_remote="$(git remote 2>/dev/null | head -n 1)"
        if [[ -n "$first_remote" ]]; then
            remote_url="$(git config --get "remote.${first_remote}.url" 2>/dev/null)"
        fi
    fi

    if [[ -n "$remote_url" ]]; then
        # Strip trailing slash & .git suffix
        local clean="${remote_url%/}"
        clean="${clean%.git}"
        # Extract name after last '/' or ':' (covers HTTPS, SSH, SCP-like URLs)
        local repository_name="${clean##*[/:]}"
        if [[ -n "$repository_name" ]]; then
            echo "$repository_name"
            return 0
        fi
    fi

    # Priority 3: Worktrees without remotes -> resolve common .git dir parent
    local common_directory
    common_directory="$(git rev-parse --git-common-dir 2>/dev/null)"
    if [[ -n "$common_directory" ]]; then
        local abs_common
        abs_common="$(readlink -f "$common_directory")"
        if [[ "$(basename "$abs_common")" == ".git" ]]; then
            basename "$(dirname "$abs_common")"
            return 0
        fi
    fi

    # Priority 4: Fall back to worktree/folder basename
    basename "$repository_root"
}

ensure_profile_settings() {
    local global_settings_file="$1"
    local profile_settings_file="$2"

    mkdir -p "$(dirname "$profile_settings_file")"

    # If profile_settings_file is a symlink, break it and convert to a standalone real file
    if [[ -L "$profile_settings_file" ]]; then
        local target
        target="$(readlink -f "$profile_settings_file" 2>/dev/null || true)"
        rm -f "$profile_settings_file"
        if [[ -n "$target" && -f "$target" ]]; then
            cp "$target" "$profile_settings_file"
        fi
    fi

    # If profile_settings_file does not exist, initialize from global without gcp/trustedWorkspaces or empty
    if [[ ! -f "$profile_settings_file" ]]; then
        if [[ -f "$global_settings_file" ]] && command -v jq >/dev/null 2>&1; then
            jq 'del(.gcp) | del(.trustedWorkspaces)' "$global_settings_file" > "$profile_settings_file" 2>/dev/null || echo '{}' > "$profile_settings_file"
        else
            echo '{}' > "$profile_settings_file"
        fi
    fi
}

atomic_write_json() {
    local dest_file="$1"
    local json_content="$2"

    local real_dest
    real_dest="$(readlink -f "$dest_file" 2>/dev/null || true)"
    [[ -z "$real_dest" ]] && real_dest="$dest_file"
    mkdir -p "$(dirname "$real_dest")"

    local tmp
    tmp="$(mktemp "${real_dest}.tmp.XXXXXX")"
    chmod 600 "$tmp"
    if echo "$json_content" > "$tmp"; then
        mv -f "$tmp" "$real_dest"
    else
        rm -f "$tmp"
        return 1
    fi
}

merge_permissions_3way() {
    local target_file="$1"
    local current_file="$2"
    local base_file="$3"

    command -v jq >/dev/null 2>&1 || return 0

    local tgt_in="/dev/null"
    local cur_in="/dev/null"
    local base_in="/dev/null"

    [[ -f "$target_file" ]] && tgt_in="$target_file"
    [[ -f "$current_file" ]] && cur_in="$current_file"
    [[ -f "$base_file" ]] && base_in="$base_file"

    local merged_json
    merged_json="$(jq -n \
        --slurpfile tgt "$tgt_in" \
        --slurpfile cur "$cur_in" \
        --slurpfile base "$base_in" '
        ($tgt[0] // {}) as $t |
        ($cur[0] // {}) as $c |
        ($base[0] // {}) as $b |

        def perm_list($obj; $k): (($obj.permissions // {})[$k] // []);

        perm_list($b; "allow") as $b_allow |
        perm_list($b; "deny")  as $b_deny  |
        perm_list($b; "ask")   as $b_ask   |

        perm_list($c; "allow") as $c_allow |
        perm_list($c; "deny")  as $c_deny  |
        perm_list($c; "ask")   as $c_ask   |

        perm_list($t; "allow") as $t_allow |
        perm_list($t; "deny")  as $t_deny  |
        perm_list($t; "ask")   as $t_ask   |

        # Deltas in current vs base
        ($c_allow - $b_allow) as $add_allow | ($b_allow - $c_allow) as $rem_allow |
        ($c_deny  - $b_deny)  as $add_deny  | ($b_deny  - $c_deny)  as $rem_deny  |
        ($c_ask   - $b_ask)   as $add_ask   | ($b_ask   - $c_ask)   as $rem_ask   |

        # Apply deltas to target
        ((($t_deny  + $add_deny)  - $rem_deny)  | unique) as $raw_deny  |
        ((($t_ask   + $add_ask)   - $rem_ask)   | unique) as $raw_ask   |
        ((($t_allow + $add_allow) - $rem_allow) | unique) as $raw_allow |

        # Enforce mutual exclusivity with precedence: deny > ask > allow
        $raw_deny as $final_deny |
        ($raw_ask - $final_deny) as $final_ask |
        (($raw_allow - $final_deny) - $final_ask) as $final_allow |

        # Merge cleanly into target permissions without clobbering other properties
        (($t.permissions // {}) + {
            allow: $final_allow,
            deny: $final_deny,
            ask: $final_ask
        })
        | if .deny == [] then del(.deny) else . end
        | if .ask == [] then del(.ask) else . end
        | if .allow == [] then del(.allow) else . end
        as $final_perms |

        $t | if $final_perms == {} then del(.permissions) else .permissions = $final_perms end
    ')" || return 1

    atomic_write_json "$target_file" "$merged_json"
}

sync_permissions_to_profile() {
    local global_settings_file="$1"
    local profile_settings_file="$2"

    [[ -f "$global_settings_file" && -f "$profile_settings_file" ]] || return 0
    command -v jq >/dev/null 2>&1 || return 0

    local base_file
    base_file="$(dirname "$profile_settings_file")/.permissions-baseline.json"

    if [[ ! -f "$base_file" ]]; then
        # Initial baseline creation: safe union
        merge_permissions_3way "$profile_settings_file" "$global_settings_file" "/dev/null"
    else
        # 3-way sync: apply Global changes to Profile against Base
        merge_permissions_3way "$profile_settings_file" "$global_settings_file" "$base_file"
    fi

    # Save current profile permissions as the new baseline for this profile
    local perms
    perms="$(jq '{permissions: (.permissions // {})} | if .permissions == {} then del(.permissions) else . end' "$profile_settings_file" 2>/dev/null || echo '{}')"
    atomic_write_json "$base_file" "$perms"
}

sync_permissions_to_global() {
    local global_settings_file="$1"
    local profile_settings_file="$2"

    [[ -f "$profile_settings_file" ]] || return 0
    command -v jq >/dev/null 2>&1 || return 0

    if [[ ! -f "$global_settings_file" ]]; then
        mkdir -p "$(dirname "$global_settings_file")"
        echo '{}' > "$global_settings_file"
    fi

    local tmp
    tmp="$(mktemp)"
    if jq -s '
        (.[0] // {}) as $g | (.[1] // {}) as $p |
        $g + {
            permissions: {
                allow: (((($g.permissions // {}).allow // []) + ((($p.permissions // {}).allow // []))) | unique),
                deny: (((($g.permissions // {}).deny // []) + ((($p.permissions // {}).deny // []))) | unique),
                ask: (((($g.permissions // {}).ask // []) + ((($p.permissions // {}).ask // []))) | unique)
            }
        }
        | if .permissions.deny == [] then del(.permissions.deny) else . end
        | if .permissions.ask == [] then del(.permissions.ask) else . end
    ' "$global_settings_file" "$profile_settings_file" > "$tmp" 2>/dev/null; then
        mv "$tmp" "$global_settings_file"
    else
        rm -f "$tmp"
    fi
}

export_profile_gcp_env() {
    local profile_settings_file="$1"

    [[ -f "$profile_settings_file" ]] || return 0
    command -v jq >/dev/null 2>&1 || return 0

    local gcp_proj gcp_loc
    gcp_proj="$(jq -r '.gcp.project // empty' "$profile_settings_file" 2>/dev/null || true)"
    gcp_loc="$(jq -r '.gcp.location // empty' "$profile_settings_file" 2>/dev/null || true)"

    if [[ -n "$gcp_proj" ]]; then
        export CLOUDSDK_CORE_PROJECT="$gcp_proj"
        export GOOGLE_CLOUD_PROJECT="$gcp_proj"
        export GOOGLE_CLOUD_QUOTA_PROJECT="$gcp_proj"
    fi
    if [[ -n "$gcp_loc" ]]; then
        export GOOGLE_CLOUD_LOCATION="$gcp_loc"
        export GOOGLE_VERTEX_LOCATION="$gcp_loc"
        export GEMINI_LOCATION="$gcp_loc"
    fi
}

link_adc_credentials() {
    local original_home="$1"
    local profile_directory="$2"

    local global_application_default_credentials="$original_home/.config/gcloud/application_default_credentials.json"
    local profile_application_default_credentials="$profile_directory/.config/gcloud/application_default_credentials.json"

    if [[ -f "$global_application_default_credentials" && ! -e "$profile_application_default_credentials" ]]; then
        mkdir -p "$(dirname "$profile_application_default_credentials")"
        ln -sfn "$global_application_default_credentials" "$profile_application_default_credentials"
    fi
}

run_profile_with_keyring() {
    local profile_directory="$1"
    shift

    export AGY_PROFILE_DIRECTORY="$profile_directory"

    dbus-run-session -- bash -s -- "$@" <<'PROFILE_RUNNER'
set -e

PROFILE_DIRECTORY="$AGY_PROFILE_DIRECTORY"

KEYRING_DIR="$PROFILE_DIRECTORY/.local/share/keyrings"
KEYRING_STATE_DIR="$PROFILE_DIRECTORY/.local/state/gnome-keyring/$BASHPID"

mkdir -p "$KEYRING_DIR" "$KEYRING_STATE_DIR"
chmod 700 "$KEYRING_DIR" "$KEYRING_STATE_DIR"

export GNOME_KEYRING_CONTROL="$KEYRING_STATE_DIR"

# Run a completely profile-local Secret Service.
#
# --foreground is important: it gives us a child process whose PID
# we own and can reliably terminate when agy exits.
gnome-keyring-daemon \
    --foreground \
    --components=secrets \
    --control-directory="$KEYRING_STATE_DIR" \
    >/dev/null 2>&1 &

KEYRING_PID=$!

cleanup_keyring() {
    local exit_code=$?

    trap - EXIT INT TERM

    if kill -0 "$KEYRING_PID" 2>/dev/null; then
        kill "$KEYRING_PID" 2>/dev/null || true
        wait "$KEYRING_PID" 2>/dev/null || true
    fi

    # The keyring database itself lives in .local/share/keyrings.
    # Only remove transient runtime/control state.
    rm -rf "$KEYRING_STATE_DIR"

    exit "$exit_code"
}

trap cleanup_keyring EXIT INT TERM

# Wait briefly for the private Secret Service to acquire its D-Bus name.
for _ in {1..50}; do
    if busctl --user status org.freedesktop.secrets >/dev/null 2>&1; then
        break
    fi

    if ! kill -0 "$KEYRING_PID" 2>/dev/null; then
        echo "Error: gnome-keyring-daemon exited unexpectedly" >&2
        exit 1
    fi

    sleep 0.02
done

if ! busctl --user status org.freedesktop.secrets >/dev/null 2>&1; then
    echo "Error: profile Secret Service did not start" >&2
    exit 1
fi

"$@"
PROFILE_RUNNER
}

main() {
    # --- 1. Find the real 'agy' binary (avoiding infinite loops) ---
    SELF="$(readlink -f "$0")"
    REAL_AGY=""

    while IFS= read -r bin; do
        [[ -x "$bin" ]] || continue
        if [[ "$(readlink -f "$bin")" != "$SELF" ]]; then
            REAL_AGY="$bin"
            break
        fi
    done < <(type -ap agy 2>/dev/null)

    if [[ -z "$REAL_AGY" ]]; then
        echo "Error: Real 'agy' binary not found in PATH." >&2
        exit 1
    fi

    # --- 2. Parse profile flags from arguments ---
    PROFILE=""
    NO_PROFILE=false
    NEW_ARGS=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-profile)
                NO_PROFILE=true
                shift
                ;;
            --profile=*)
                PROFILE="${1#*=}"
                shift
                ;;
            --profile)
                if [[ $# -lt 2 || -z "$2" ]]; then
                    echo "Error: --profile requires a non-empty argument." >&2
                    exit 1
                fi
                PROFILE="$2"
                shift 2
                ;;
            --)
                shift
                NEW_ARGS+=("$@")
                break
                ;;
            *)
                NEW_ARGS+=("$1")
                shift
                ;;
        esac
    done

    # --- 3. Determine active profile ---
    if [[ "$NO_PROFILE" == "false" && -z "$PROFILE" ]]; then
        if repository_name="$(detect_repo_name)"; then
            PROFILE="$repository_name"
        fi
    fi

    # --- 4. Apply hybrid $HOME isolation ---
    if [[ "$NO_PROFILE" == "false" && -n "$PROFILE" ]]; then
        PROFILE_DIRECTORY="$PROFILES_BASE/$PROFILE"

        # Create profile directory structure
        mkdir -p "$PROFILE_DIRECTORY" \
                 "$PROFILE_DIRECTORY/.config" \
                 "$PROFILE_DIRECTORY/.local/share" \
                 "$PROFILE_DIRECTORY/.local/state" \
                 "$PROFILE_DIRECTORY/.cache"

        # Link shared identity & authentication
        [[ -d "$ORIGINAL_HOME/.ssh" ]] && ln -sfn "$ORIGINAL_HOME/.ssh" "$PROFILE_DIRECTORY/.ssh"
        [[ -f "$ORIGINAL_HOME/.gitconfig" ]] && ln -sfn "$ORIGINAL_HOME/.gitconfig" "$PROFILE_DIRECTORY/.gitconfig"
        [[ -f "$ORIGINAL_HOME/.gitconfig.local" ]] && ln -sfn "$ORIGINAL_HOME/.gitconfig.local" "$PROFILE_DIRECTORY/.gitconfig.local"
        [[ -f "$ORIGINAL_HOME/.gitignore.global" ]] && ln -sfn "$ORIGINAL_HOME/.gitignore.global" "$PROFILE_DIRECTORY/.gitignore.global"
        [[ -f "$ORIGINAL_HOME/.git-credentials" ]] && ln -sfn "$ORIGINAL_HOME/.git-credentials" "$PROFILE_DIRECTORY/.git-credentials"
        [[ -d "$ORIGINAL_HOME/.gnupg" ]] && ln -sfn "$ORIGINAL_HOME/.gnupg" "$PROFILE_DIRECTORY/.gnupg"
        [[ -d "$ORIGINAL_HOME/.config/gh" ]] && ln -sfn "$ORIGINAL_HOME/.config/gh" "$PROFILE_DIRECTORY/.config/gh"
        [[ -d "$ORIGINAL_HOME/.config/git" ]] && ln -sfn "$ORIGINAL_HOME/.config/git" "$PROFILE_DIRECTORY/.config/git"

        # Link shared skills/plugins from dotfiles (~/.agents)
        [[ -d "$ORIGINAL_HOME/.agents" ]] && ln -sfn "$ORIGINAL_HOME/.agents" "$PROFILE_DIRECTORY/.agents"

        # Setup standalone profile settings, sync permissions, export GCP env & link ADC
        GLOBAL_SETTINGS="$ORIGINAL_HOME/.gemini/antigravity-cli/settings.json"
        PROFILE_SETTINGS="$PROFILE_DIRECTORY/.gemini/antigravity-cli/settings.json"

        ensure_profile_settings "$GLOBAL_SETTINGS" "$PROFILE_SETTINGS"
        sync_permissions_to_profile "$GLOBAL_SETTINGS" "$PROFILE_SETTINGS"
        export_profile_gcp_env "$PROFILE_SETTINGS"
        link_adc_credentials "$ORIGINAL_HOME" "$PROFILE_DIRECTORY"

        # Link global gemini config (MCP servers, plugins, etc.)
        if [[ -d "$ORIGINAL_HOME/.gemini/config" ]]; then
            if [[ -d "$PROFILE_DIRECTORY/.gemini/config" && ! -L "$PROFILE_DIRECTORY/.gemini/config" ]]; then
                rm -rf "$PROFILE_DIRECTORY/.gemini/config"
            fi
            ln -sfn "$ORIGINAL_HOME/.gemini/config" "$PROFILE_DIRECTORY/.gemini/config"
        fi

        # Link shell startup files so subshells maintain your environment & PATH
        for rc in .bashrc .bash_profile .profile .zshrc .zshenv; do
            [[ -f "$ORIGINAL_HOME/$rc" ]] && ln -sfn "$ORIGINAL_HOME/$rc" "$PROFILE_DIRECTORY/$rc"
        done

        # Switch environment to the profile
        export REAL_HOME="$ORIGINAL_HOME"
        export HOME="$PROFILE_DIRECTORY"
        export XDG_CONFIG_HOME="$PROFILE_DIRECTORY/.config"
        export XDG_DATA_HOME="$PROFILE_DIRECTORY/.local/share"
        export XDG_STATE_HOME="$PROFILE_DIRECTORY/.local/state"
        export XDG_CACHE_HOME="$PROFILE_DIRECTORY/.cache"
    fi

    # --- 5. Execute with selective permissions exit sync ---
    if [[ "$NO_PROFILE" == "false" && -n "$PROFILE" ]]; then
        # shellcheck disable=SC2329
        cleanup_settings() {
            local profile_settings="$PROFILE_DIRECTORY/.gemini/antigravity-cli/settings.json"
            local global_settings="$ORIGINAL_HOME/.gemini/antigravity-cli/settings.json"

            sync_permissions_to_global "$global_settings" "$profile_settings"
        }

        trap cleanup_settings EXIT
        run_profile_with_keyring "$PROFILE_DIRECTORY" "$REAL_AGY" "${NEW_ARGS[@]}"
        EXIT_CODE=$?
        exit "$EXIT_CODE"
    else
        exec "$REAL_AGY" "${NEW_ARGS[@]}"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
