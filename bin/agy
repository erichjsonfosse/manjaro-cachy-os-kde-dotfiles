#!/usr/bin/env bash
set -eo pipefail

# Capture the true user home before overriding
ORIG_HOME="${REAL_HOME:-$HOME}"
if [[ -n "$REAL_HOME" ]]; then
    PROFILES_BASE="$REAL_HOME/.local/share/agy/profiles"
else
    PROFILES_BASE="${XDG_DATA_HOME:-$ORIG_HOME/.local/share}/agy/profiles"
fi

# --- Git Repository Detection ---
detect_repo_name() {
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        return 1
    fi

    local repo_root
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"

    # Priority 1: In-repo explicit override file (.agy-profile)
    if [[ -f "$repo_root/.agy-profile" ]]; then
        local override
        override="$(head -n 1 "$repo_root/.agy-profile" | tr -d '[:space:]')"
        if [[ -n "$override" ]]; then
            echo "$override"
            return 0
        fi
    fi

    # Priority 2: Remote URL (origin or first available remote)
    local remote_url
    remote_url="$(git config --get remote.origin.url 2>/dev/null)"
    if [[ -z "$remote_url" ]]; then
        local first_remote
        first_remote="$(git remote 2>/dev/null | head -n 1)"
        if [[ -n "$first_remote" ]]; then
            remote_url="$(git config --get "remote.${first_remote}.url" 2>/dev/null)"
        fi
    fi

    if [[ -n "$remote_url" ]]; then
        # Strip trailing slash & .git suffix
        local clean="${remote_url%/}"
        clean="${clean%.git}"
        # Extract name after last '/' or ':' (covers HTTPS, SSH, SCP-like URLs)
        local repo_name="${clean##*[/:]}"
        if [[ -n "$repo_name" ]]; then
            echo "$repo_name"
            return 0
        fi
    fi

    # Priority 3: Worktrees without remotes -> resolve common .git dir parent
    local common_dir
    common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"
    if [[ -n "$common_dir" ]]; then
        local abs_common
        abs_common="$(readlink -f "$common_dir")"
        if [[ "$(basename "$abs_common")" == ".git" ]]; then
            basename "$(dirname "$abs_common")"
            return 0
        fi
    fi

    # Priority 4: Fall back to worktree/folder basename
    basename "$repo_root"
}

ensure_profile_settings() {
    local global_file="$1"
    local prof_file="$2"

    mkdir -p "$(dirname "$prof_file")"

    # If prof_file is a symlink, break it and convert to a standalone real file
    if [[ -L "$prof_file" ]]; then
        local target
        target="$(readlink -f "$prof_file" 2>/dev/null || true)"
        rm -f "$prof_file"
        if [[ -n "$target" && -f "$target" ]]; then
            cp "$target" "$prof_file"
        fi
    fi

    # If prof_file does not exist, initialize from global without gcp/trustedWorkspaces or empty
    if [[ ! -f "$prof_file" ]]; then
        if [[ -f "$global_file" ]] && command -v jq >/dev/null 2>&1; then
            jq 'del(.gcp) | del(.trustedWorkspaces)' "$global_file" > "$prof_file" 2>/dev/null || echo '{}' > "$prof_file"
        else
            echo '{}' > "$prof_file"
        fi
    fi
}

sync_permissions_to_profile() {
    local global_file="$1"
    local prof_file="$2"

    [[ -f "$global_file" && -f "$prof_file" ]] || return 0
    command -v jq >/dev/null 2>&1 || return 0

    local tmp
    tmp="$(mktemp)"
    if jq -s '
        (.[0] // {}) as $g | (.[1] // {}) as $p |
        $p + {
            permissions: {
                allow: (((($p.permissions // {}).allow // []) + ((($g.permissions // {}).allow // []))) | unique),
                deny: (((($p.permissions // {}).deny // []) + ((($g.permissions // {}).deny // []))) | unique),
                ask: (((($p.permissions // {}).ask // []) + ((($g.permissions // {}).ask // []))) | unique)
            }
        }
        | if .permissions.deny == [] then del(.permissions.deny) else . end
        | if .permissions.ask == [] then del(.permissions.ask) else . end
    ' "$global_file" "$prof_file" > "$tmp" 2>/dev/null; then
        mv "$tmp" "$prof_file"
    else
        rm -f "$tmp"
    fi
}

sync_permissions_to_global() {
    local global_file="$1"
    local prof_file="$2"

    [[ -f "$prof_file" ]] || return 0
    command -v jq >/dev/null 2>&1 || return 0

    if [[ ! -f "$global_file" ]]; then
        mkdir -p "$(dirname "$global_file")"
        echo '{}' > "$global_file"
    fi

    local tmp
    tmp="$(mktemp)"
    if jq -s '
        (.[0] // {}) as $g | (.[1] // {}) as $p |
        $g + {
            permissions: {
                allow: (((($g.permissions // {}).allow // []) + ((($p.permissions // {}).allow // []))) | unique),
                deny: (((($g.permissions // {}).deny // []) + ((($p.permissions // {}).deny // []))) | unique),
                ask: (((($g.permissions // {}).ask // []) + ((($p.permissions // {}).ask // []))) | unique)
            }
        }
        | if .permissions.deny == [] then del(.permissions.deny) else . end
        | if .permissions.ask == [] then del(.permissions.ask) else . end
    ' "$global_file" "$prof_file" > "$tmp" 2>/dev/null; then
        mv "$tmp" "$global_file"
    else
        rm -f "$tmp"
    fi
}

export_profile_gcp_env() {
    local prof_file="$1"

    [[ -f "$prof_file" ]] || return 0
    command -v jq >/dev/null 2>&1 || return 0

    local gcp_proj gcp_loc
    gcp_proj="$(jq -r '.gcp.project // empty' "$prof_file" 2>/dev/null || true)"
    gcp_loc="$(jq -r '.gcp.location // empty' "$prof_file" 2>/dev/null || true)"

    if [[ -n "$gcp_proj" ]]; then
        export CLOUDSDK_CORE_PROJECT="$gcp_proj"
        export GOOGLE_CLOUD_PROJECT="$gcp_proj"
        export GOOGLE_CLOUD_QUOTA_PROJECT="$gcp_proj"
    fi
    if [[ -n "$gcp_loc" ]]; then
        export GOOGLE_CLOUD_LOCATION="$gcp_loc"
        export GOOGLE_VERTEX_LOCATION="$gcp_loc"
        export GEMINI_LOCATION="$gcp_loc"
    fi
}

link_adc_credentials() {
    local orig_home="$1"
    local profile_dir="$2"

    local global_adc="$orig_home/.config/gcloud/application_default_credentials.json"
    local prof_adc="$profile_dir/.config/gcloud/application_default_credentials.json"

    if [[ -f "$global_adc" && ! -e "$prof_adc" ]]; then
        mkdir -p "$(dirname "$prof_adc")"
        ln -sfn "$global_adc" "$prof_adc"
    fi
}

run_profile_with_keyring() {
    local profile_dir="$1"
    shift

    export AGY_PROFILE_DIR="$profile_dir"

    dbus-run-session -- bash -s -- "$@" <<'PROFILE_RUNNER'
set -e

PROFILE_DIR="$AGY_PROFILE_DIR"

KEYRING_DIR="$PROFILE_DIR/.local/share/keyrings"
KEYRING_STATE_DIR="$PROFILE_DIR/.local/state/gnome-keyring/$BASHPID"

mkdir -p "$KEYRING_DIR" "$KEYRING_STATE_DIR"
chmod 700 "$KEYRING_DIR" "$KEYRING_STATE_DIR"

export GNOME_KEYRING_CONTROL="$KEYRING_STATE_DIR"

# Run a completely profile-local Secret Service.
#
# --foreground is important: it gives us a child process whose PID
# we own and can reliably terminate when agy exits.
gnome-keyring-daemon \
    --foreground \
    --components=secrets \
    --control-directory="$KEYRING_STATE_DIR" \
    >/dev/null 2>&1 &

KEYRING_PID=$!

cleanup_keyring() {
    local exit_code=$?

    trap - EXIT INT TERM

    if kill -0 "$KEYRING_PID" 2>/dev/null; then
        kill "$KEYRING_PID" 2>/dev/null || true
        wait "$KEYRING_PID" 2>/dev/null || true
    fi

    # The keyring database itself lives in .local/share/keyrings.
    # Only remove transient runtime/control state.
    rm -rf "$KEYRING_STATE_DIR"

    exit "$exit_code"
}

trap cleanup_keyring EXIT INT TERM

# Wait briefly for the private Secret Service to acquire its D-Bus name.
for _ in {1..50}; do
    if busctl --user status org.freedesktop.secrets >/dev/null 2>&1; then
        break
    fi

    if ! kill -0 "$KEYRING_PID" 2>/dev/null; then
        echo "Error: gnome-keyring-daemon exited unexpectedly" >&2
        exit 1
    fi

    sleep 0.02
done

if ! busctl --user status org.freedesktop.secrets >/dev/null 2>&1; then
    echo "Error: profile Secret Service did not start" >&2
    exit 1
fi

"$@"
PROFILE_RUNNER
}

main() {
    # --- 1. Find the real 'agy' binary (avoiding infinite loops) ---
    SELF="$(readlink -f "$0")"
    REAL_AGY=""

    while IFS= read -r bin; do
        [[ -x "$bin" ]] || continue
        if [[ "$(readlink -f "$bin")" != "$SELF" ]]; then
            REAL_AGY="$bin"
            break
        fi
    done < <(type -ap agy 2>/dev/null)

    if [[ -z "$REAL_AGY" ]]; then
        echo "Error: Real 'agy' binary not found in PATH." >&2
        exit 1
    fi

    # --- 2. Parse profile flags from arguments ---
    PROFILE=""
    NO_PROFILE=false
    NEW_ARGS=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-profile)
                NO_PROFILE=true
                shift
                ;;
            --profile=*)
                PROFILE="${1#*=}"
                shift
                ;;
            --profile)
                if [[ $# -lt 2 || -z "$2" ]]; then
                    echo "Error: --profile requires a non-empty argument." >&2
                    exit 1
                fi
                PROFILE="$2"
                shift 2
                ;;
            --)
                shift
                NEW_ARGS+=("$@")
                break
                ;;
            *)
                NEW_ARGS+=("$1")
                shift
                ;;
        esac
    done

    # --- 3. Determine active profile ---
    if [[ "$NO_PROFILE" == "false" && -z "$PROFILE" ]]; then
        if repo_name="$(detect_repo_name)"; then
            PROFILE="$repo_name"
        fi
    fi

    # --- 4. Apply hybrid $HOME isolation ---
    if [[ "$NO_PROFILE" == "false" && -n "$PROFILE" ]]; then
        PROFILE_DIR="$PROFILES_BASE/$PROFILE"

        # Create profile directory structure
        mkdir -p "$PROFILE_DIR" \
                 "$PROFILE_DIR/.config" \
                 "$PROFILE_DIR/.local/share" \
                 "$PROFILE_DIR/.local/state" \
                 "$PROFILE_DIR/.cache"

        # Link shared identity & authentication
        [[ -d "$ORIG_HOME/.ssh" ]] && ln -sfn "$ORIG_HOME/.ssh" "$PROFILE_DIR/.ssh"
        [[ -f "$ORIG_HOME/.gitconfig" ]] && ln -sfn "$ORIG_HOME/.gitconfig" "$PROFILE_DIR/.gitconfig"
        [[ -f "$ORIG_HOME/.gitconfig.local" ]] && ln -sfn "$ORIG_HOME/.gitconfig.local" "$PROFILE_DIR/.gitconfig.local"
        [[ -f "$ORIG_HOME/.gitignore.global" ]] && ln -sfn "$ORIG_HOME/.gitignore.global" "$PROFILE_DIR/.gitignore.global"
        [[ -f "$ORIG_HOME/.git-credentials" ]] && ln -sfn "$ORIG_HOME/.git-credentials" "$PROFILE_DIR/.git-credentials"
        [[ -d "$ORIG_HOME/.gnupg" ]] && ln -sfn "$ORIG_HOME/.gnupg" "$PROFILE_DIR/.gnupg"
        [[ -d "$ORIG_HOME/.config/gh" ]] && ln -sfn "$ORIG_HOME/.config/gh" "$PROFILE_DIR/.config/gh"
        [[ -d "$ORIG_HOME/.config/git" ]] && ln -sfn "$ORIG_HOME/.config/git" "$PROFILE_DIR/.config/git"

        # Link shared skills/plugins from dotfiles (~/.agents)
        [[ -d "$ORIG_HOME/.agents" ]] && ln -sfn "$ORIG_HOME/.agents" "$PROFILE_DIR/.agents"

        # Setup standalone profile settings, sync permissions, export GCP env & link ADC
        GLOBAL_SETTINGS="$ORIG_HOME/.gemini/antigravity-cli/settings.json"
        PROF_SETTINGS="$PROFILE_DIR/.gemini/antigravity-cli/settings.json"

        ensure_profile_settings "$GLOBAL_SETTINGS" "$PROF_SETTINGS"
        sync_permissions_to_profile "$GLOBAL_SETTINGS" "$PROF_SETTINGS"
        export_profile_gcp_env "$PROF_SETTINGS"
        link_adc_credentials "$ORIG_HOME" "$PROFILE_DIR"

        # Link global gemini config (MCP servers, plugins, etc.)
        if [[ -d "$ORIG_HOME/.gemini/config" ]]; then
            if [[ -d "$PROFILE_DIR/.gemini/config" && ! -L "$PROFILE_DIR/.gemini/config" ]]; then
                rm -rf "$PROFILE_DIR/.gemini/config"
            fi
            ln -sfn "$ORIG_HOME/.gemini/config" "$PROFILE_DIR/.gemini/config"
        fi

        # Link shell startup files so subshells maintain your environment & PATH
        for rc in .bashrc .bash_profile .profile .zshrc .zshenv; do
            [[ -f "$ORIG_HOME/$rc" ]] && ln -sfn "$ORIG_HOME/$rc" "$PROFILE_DIR/$rc"
        done

        # Switch environment to the profile
        export REAL_HOME="$ORIG_HOME"
        export HOME="$PROFILE_DIR"
        export XDG_CONFIG_HOME="$PROFILE_DIR/.config"
        export XDG_DATA_HOME="$PROFILE_DIR/.local/share"
        export XDG_STATE_HOME="$PROFILE_DIR/.local/state"
        export XDG_CACHE_HOME="$PROFILE_DIR/.cache"
    fi

    # --- 5. Execute with selective permissions exit sync ---
    if [[ "$NO_PROFILE" == "false" && -n "$PROFILE" ]]; then
        # shellcheck disable=SC2329
        cleanup_settings() {
            local prof_settings="$PROFILE_DIR/.gemini/antigravity-cli/settings.json"
            local global_settings="$ORIG_HOME/.gemini/antigravity-cli/settings.json"

            sync_permissions_to_global "$global_settings" "$prof_settings"
        }

        trap cleanup_settings EXIT
        run_profile_with_keyring "$PROFILE_DIR" "$REAL_AGY" "${NEW_ARGS[@]}"
        EXIT_CODE=$?
        exit "$EXIT_CODE"
    else
        exec "$REAL_AGY" "${NEW_ARGS[@]}"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
